{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only what Firewol's interface calls: its own commands, event listening and window controls",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "allow-startup",
    "allow-navigate",
    "allow-close-pane",
    "allow-suspend-pane",
    "allow-adopt-pane",
    "allow-list-page",
    "allow-folder-progress",
    "allow-default-apps",
    "allow-remember-tabs",
    "allow-set-file-dialogs",
    "allow-pick-ready",
    "allow-pick-matches",
    "allow-pick-resolve",
    "allow-finish-pick",
    "allow-set-pick-filter",
    "allow-set-default-folders",
    "allow-folder-groups",
    "allow-locate-selection",
    "allow-start-index",
    "allow-search",
    "allow-search-count",
    "allow-ntfs-drive",
    "allow-volume-states",
    "allow-start-volume-index",
    "allow-stop-volume-index",
    "allow-session",
    "allow-set-clipboard",
    "allow-paste",
    "allow-transfer",
    "allow-rename",
    "allow-recycle",
    "allow-subfolders",
    "allow-drive-space",
    "allow-drives",
    "allow-undo",
    "allow-transfer-status",
    "allow-pause-transfer",
    "allow-cancel-transfer",
    "allow-toggle-pin",
    "allow-move-pin",
    "allow-get-settings",
    "allow-update-settings",
    "allow-set-folder-style",
    "allow-operation-busy",
    "allow-run-menu-action",
    "allow-run-as-administrator",
    "allow-pick-custom-icon",
    "allow-reset-custom-icon",
    "allow-open-items",
    "allow-set-folder-view",
    "allow-menu-places",
    "allow-open-terminal",
    "allow-open-system-uri",
    "allow-item-attributes",
    "allow-set-item-attribute",
    "allow-create-folder",
    "allow-create-file",
    "allow-take-ownership",
    "allow-shell-menu-open",
    "allow-shell-menu-invoke",
    "allow-shell-menu-invoke-new",
    "allow-shell-menu-native",
    "allow-shell-menu-close",
    "allow-open-window",
    "allow-save-report",
    "allow-await-signal"
  ]
}
