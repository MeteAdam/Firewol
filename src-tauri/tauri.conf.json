{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Firewol M0",
  "version": "0.1.0",
  "identifier": "dev.firewol.m0",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Firewol M0",
        "width": 900,
        "height": 680,
        "minWidth": 520,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
